@page "/usuario/login"
@inject HttpClient Http
@using System.Net.Http.Json

<div class="container">

	<div class="container min-vh-100 d-flex align-items-center justify-content-center">
		<div class="row w-100 justify-content-center">
			<div class="col-12 col-md-8 col-lg-6">

				<div class="card shadow-sm">
					<div class="card-body">

						<h1 class="card-title mb-4">Login</h1>

						<EditForm class="row g-3" Model="loginModel" onsubmit="Logar">

							<div class="mb-3">
								<label for="email" class="form-label">Email</label>
								<InputText class="form-control" type="email" @bind-Value=loginModel.Email required />
							</div>

							<div class="mb-3">
								<label for="senha" class="form-label">Senha</label>
								<InputText class="form-control" type="password" @bind-Value=loginModel.Senha required />
							</div>

							<div class="mb-3">
								<label for="criar-conta" class="form-label">Ainda não tenho conta</label>
								<NavLink href="/usuario/cadastro">Criar Conta</NavLink>
							</div>

							<button type="submit" class="btn btn-primary">
								Entrar
							</button>

						</EditForm>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@if (!string.IsNullOrEmpty(mensagem))
{
	<div class="alert alert-danger" role="alert">
		<p>@mensagem</p>
	</div>
}

@code {

	private string mensagem = string.Empty;
	private LoginModel loginModel = new LoginModel();


	private async Task Logar()
	{
		var response = await Http.PostAsJsonAsync("api/usuarios/login", loginModel);

		if(response.IsSuccessStatusCode)
		{
			mensagem = "Login realizado com sucesso!";
			return;
		}
        
		mensagem = "Email ou senha inválidos.";
       
	}

	private class LoginModel
	{
		public string Email { get; set; } = string.Empty;
		public string Senha { get; set; } = string.Empty;
	}
}
