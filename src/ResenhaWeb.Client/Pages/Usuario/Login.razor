@page "/usuario/login"

<div class="container">

	<div class="container min-vh-100 d-flex align-items-center justify-content-center">
		<div class="row w-100 justify-content-center">
			<div class="col-12 col-md-8 col-lg-6">

				<div class="card shadow-sm">
					<div class="card-body">

						<h1 class="card-title mb-4">Login</h1>

						<EditForm class="row g-3" Model="loginModel" onsubmit="Logar">

							<div class="mb-3">
								<label for="email" class="form-label">Email</label>
								<InputText class="form-control" type="email" @bind-Value=loginModel.Email required />
							</div>

							<div class="mb-3">
								<label for="senha" class="form-label">Senha</label>
								<InputText class="form-control" type="password" @bind-Value=loginModel.Senha required />
							</div>

							<div class="mb-3">
								<label for="criar-conta" class="form-label">Ainda não tenho conta</label>
								<NavLink href="/usuario/cadastro">Criar Conta</NavLink>
							</div>

							<button type="submit" class="btn btn-primary">
								Entrar
							</button>

						</EditForm>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@code {

	private LoginModel loginModel = new LoginModel();


	private async Task Logar()
	{

		if (string.IsNullOrWhiteSpace(loginModel.Email) || string.IsNullOrWhiteSpace(loginModel.Senha))
		{
			// Exibir mensagem de erro ou realizar alguma ação apropriada
			return;
		}

		// Lógica para autenticar o usuário com base nos dados do loginModel
		// Por exemplo, você pode chamar um serviço de autenticação aqui
		// e redirecionar o usuário para outra página se a autenticação for bem-sucedida.
	}

	private class LoginModel
	{
		public string Email { get; set; } = string.Empty;
		public string Senha { get; set; } = string.Empty;
	}
}
