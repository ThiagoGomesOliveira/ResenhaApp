@using System.Net.Http.Json
@inject HttpClient Http
@page "/usuario/cadastro"

<div class="container">
	<div class="row justify-content-center">
		<div class="col-12 col-md-8 col-lg-6">

			<div class="card shadow-sm">
				<div class="card-body">

					<h1 class="card-title mb-4">Cadastro</h1>

					<EditForm Model="registrarUsuarioModel"
							  OnValidSubmit="Cadastrar">

						<div class="mb-3">
							<label for="nome" class="form-label">
								Nome
							</label>

							<InputText id="nome"
									   class="form-control"
									   @bind-Value="registrarUsuarioModel.Nome" />
						</div>

						<div class="mb-3">
							<label for="email" class="form-label">
								Email
							</label>

							<InputText id="email"
									   type="email"
									   class="form-control"
									   @bind-Value="registrarUsuarioModel.Email" />
						</div>

						<div class="mb-3">
							<label for="senha" class="form-label">
								Senha
							</label>

							<InputText id="senha"
									   type="password"
									   class="form-control"
									   @bind-Value="registrarUsuarioModel.Senha" />
						</div>

						<div class="mb-3">
							<label for="telefone" class="form-label">
								Telefone
							</label>

							<InputText id="telefone"
									   class="form-control"
									   @bind-Value="registrarUsuarioModel.Telefone" />
						</div>

						<button type="submit" class="btn btn-primary">
							Cadastrar
						</button>

					</EditForm>

				</div>
			</div>

		</div>
	</div>
</div>

@if (!string.IsNullOrEmpty(mensagem))
{
	<p>@mensagem</p>
}

@code {

	private RegistrarUsuarioModel registrarUsuarioModel = new();

	private string mensagem = string.Empty;

	private async Task Cadastrar()
	{
		var response = await Http.PostAsJsonAsync("api/usuarios/", registrarUsuarioModel);

		if (response.IsSuccessStatusCode)
		{
			mensagem = "Cadastro realizado com sucesso";
			return;
		}

		mensagem = $"Erro ao realizar cadastro {response.RequestMessage}";
	}

	private class RegistrarUsuarioModel
	{
		public string Nome { get; set; } = string.Empty;
		public string Email { get; set; } = string.Empty;
		public string Senha { get; set; } = string.Empty;
		public string? Telefone { get; set; }
	}
}
